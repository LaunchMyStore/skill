{
  "name": "Trending products",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Trending now"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Tag to match",
